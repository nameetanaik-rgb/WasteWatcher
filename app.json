
{
  "expo": {
    "name": "WasteWatcher",
    "slug": "WasteWatcher",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wastewatcher.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "WasteWatcher needs access to your photos so you can select waste images.",
          "cameraPermission": "WasteWatcher needs camera access to capture waste images.",
          "microphonePermission": false
        }
      ],
      "react-native-fast-tflite",
      [
        "expo-camera",
        {
          "cameraPermission": "WasteWatcher needs camera access to capture waste images.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "276e5b72-5bc8-4221-b32e-566e37966828"
      }
    }
  }
}
